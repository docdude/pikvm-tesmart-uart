#!/bin/bash
# Runs as kvmd ExecStartPre. Writes only when something is missing or stale,
# and never edits PiKVM-owned web files.
set -euo pipefail

PY_SOURCE="/usr/local/lib/tesmart/tesmart_uart.py"
CSS_SOURCE="/usr/local/lib/tesmart/tesmart.css"
UI_GENERATOR="/usr/local/bin/tesmart-kvmd-ui"
UI_OVERRIDE="/etc/kvmd/override.d/tesmart.yaml"

# Official user stylesheet hook: nginx serves it as share/css/user.css.
USER_CSS="/etc/kvmd/web.css"
CSS_BEGIN="/* BEGIN tesmart (managed by install-tesmart-kvmd-plugin) */"
CSS_END="/* END tesmart */"

# Earlier hks401-named revisions; removed if still present.
LEGACY_CSS="/usr/share/kvmd/web/share/css/hks401.css"
KVM_INDEX="/usr/share/kvmd/web/kvm/index.html"
LEGACY_LINK='<link rel="stylesheet" href="../share/css/hks401.css">'

#
# PiKVM boots with a read-only root; remount only if a write is needed.
#
REMOUNTED=0

ensure_rw() {
    if [[ $REMOUNTED -eq 0 ]] && findmnt -no OPTIONS / | tr ',' '\n' | grep -qx ro; then
        mount -o remount,rw /
        REMOUNTED=1
    fi
}

restore_ro() {
    if [[ $REMOUNTED -eq 1 ]]; then
        sync
        mount -o remount,ro / || echo "WARNING: could not remount / read-only" >&2
    fi
}

trap restore_ro EXIT

#
# Verify persistent TESmart sources.
#
for source in "$PY_SOURCE" "$CSS_SOURCE" "$UI_GENERATOR"; do
    if [[ ! -f "$source" ]]; then
        echo "ERROR: TESmart source not found: $source" >&2
        exit 1
    fi
done

#
# Locate the UGPIO plugin directory for the currently installed KVMD.
#
PLUGIN_DIR="$(
    python3 - <<'PY'
import os
import kvmd.plugins.ugpio
print(os.path.dirname(os.path.realpath(kvmd.plugins.ugpio.__file__)))
PY
)"

# kvmd ships its own "tesmart" driver (network KVMs), hence tesmart_uart.
PLUGIN_TARGET="${PLUGIN_DIR}/tesmart_uart.py"

echo "KVMD UGPIO directory: $PLUGIN_DIR"
echo "TESmart source:       $PY_SOURCE"
echo "Plugin target:        $PLUGIN_TARGET"

#
# Install/recover the TESmart UGPIO plugin symlink.
#
if [[ -L "$PLUGIN_TARGET" ]]; then
    CURRENT="$(readlink -f "$PLUGIN_TARGET")"

    if [[ "$CURRENT" == "$PY_SOURCE" ]]; then
        echo "TESmart symlink already correct."
    else
        echo "Replacing stale TESmart symlink:"
        echo "  old -> $CURRENT"
        ensure_rw
        ln -sfn "$PY_SOURCE" "$PLUGIN_TARGET"
        echo "  new -> $PY_SOURCE"
    fi

#
# Never overwrite a real plugin file.
#
elif [[ -e "$PLUGIN_TARGET" ]]; then
    echo "ERROR: $PLUGIN_TARGET exists and is not a symlink." >&2
    echo "Refusing to overwrite it." >&2
    exit 1

else
    ensure_rw
    ln -s "$PY_SOURCE" "$PLUGIN_TARGET"
    echo "Created TESmart plugin symlink."
fi

# The old hks401 plugin symlink (only ever a symlink to our source).
if [[ -L "${PLUGIN_DIR}/hks401.py" ]]; then
    ensure_rw
    rm -f "${PLUGIN_DIR}/hks401.py"
    echo "Removed legacy hks401 plugin symlink."
fi

#
# Verify that the currently installed KVMD can load the plugin.
#
python3 - <<'PY'
from kvmd.plugins import get_plugin_class

cls = get_plugin_class("ugpio", "tesmart_uart")

print("TESmart plugin import OK")
print("Class:", cls)
print("Module:", cls.__module__)
PY

#
# Generate the GPIO scheme/view for the connected unit. If tesmartd can't
# settle a model (KVM off, daemon down), keep the existing file.
#
if WANTED_UI="$("$UI_GENERATOR" --wait 10)"; then
    if [[ "$(cat "$UI_OVERRIDE" 2>/dev/null || true)" == "$WANTED_UI" ]]; then
        echo "TESmart UI override already current."
    else
        ensure_rw
        printf '%s\n' "$WANTED_UI" > "${UI_OVERRIDE}.tmp"
        chmod 0644 "${UI_OVERRIDE}.tmp"
        mv "${UI_OVERRIDE}.tmp" "$UI_OVERRIDE"
        echo "Updated $UI_OVERRIDE: $(head -1 "$UI_OVERRIDE" | sed 's/^# Generated by tesmart-kvmd-ui for //')"
    fi
elif [[ -f "$UI_OVERRIDE" ]]; then
    echo "WARNING: could not generate the TESmart UI; keeping $UI_OVERRIDE" >&2
else
    echo "WARNING: could not generate the TESmart UI; no TESmart controls this start" >&2
fi

#
# Install/refresh the TESmart block in the user stylesheet, preserving any
# other user CSS (and dropping the old hks401 block).
#
CURRENT_CSS="$(cat "$USER_CSS" 2>/dev/null || true)"
OTHER_CSS="$(
    printf '%s\n' "$CURRENT_CSS" \
        | sed -e '\|^/\* BEGIN tesmart |,\|^/\* END tesmart \*/$|d' \
              -e '\|^/\* BEGIN hks401 |,\|^/\* END hks401 \*/$|d'
)"
WANTED_CSS="$(
    [[ -n "$OTHER_CSS" ]] && printf '%s\n\n' "$OTHER_CSS"
    printf '%s\n' "$CSS_BEGIN"
    cat "$CSS_SOURCE"
    printf '%s\n' "$CSS_END"
)"

if [[ "$CURRENT_CSS" == "$WANTED_CSS" ]]; then
    echo "TESmart stylesheet block already current."
else
    ensure_rw
    printf '%s\n' "$WANTED_CSS" > "${USER_CSS}.tmp"
    chmod 0644 "${USER_CSS}.tmp"
    mv "${USER_CSS}.tmp" "$USER_CSS"
    echo "Updated TESmart stylesheet block in $USER_CSS"
fi

#
# Remove legacy modifications of PiKVM web files.
#
if [[ -f "$KVM_INDEX" ]] && grep -Fq "$LEGACY_LINK" "$KVM_INDEX"; then
    ensure_rw
    sed -i '\|href="\.\./share/css/hks401\.css"|d' "$KVM_INDEX"
    echo "Removed legacy HKS401 link from $KVM_INDEX"
fi

if [[ -e "$LEGACY_CSS" ]]; then
    ensure_rw
    rm -f "$LEGACY_CSS"
    echo "Removed legacy $LEGACY_CSS"
fi

# The hks401 driver type no longer exists, so its override would stop kvmd.
if [[ -f /etc/kvmd/override.d/hks401.yaml ]]; then
    ensure_rw
    rm -f /etc/kvmd/override.d/hks401.yaml
    echo "Removed legacy /etc/kvmd/override.d/hks401.yaml"
fi

echo
echo "TESmart KVMD plugin and web UI installation OK."
