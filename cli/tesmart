#!/usr/bin/env python3
"""Command-line client for tesmartd."""

import json
import socket
import sys

SOCKET = "/run/tesmartd.sock"

QUERIES = (
    "ports",
    "focus",
    "correspondence",
    "buzzer",
    "lighting",
    "km_mode",
    "network",
    "mouse",
    "fan",
    "audio_follow",
    "audio",
    "autoscan",
    "auto_detect",
    "scan_interval",
    "mixed_focus",
)


def usage():
    print(
        f"Usage: {sys.argv[0]} "
        "{PC|next|OUTPUT PC|OUTPUT next|state|model|query <name>|set <name> <value>}",
        file=sys.stderr,
    )
    print(
        "  PC selects all outputs (1-N); OUTPUT is a, b, ... on multi-output units.",
        file=sys.stderr,
    )
    print(
        "Query names: " + ", ".join(QUERIES),
        file=sys.stderr,
    )
    print(
        "Set examples: buzzer on|off|low|medium|high, "
        "km_mode passthrough|compatible, "
        "lighting off|indicator|marquee|breathing, "
        "fan off|auto|low|high, audio pc1-pcN|next, mixed_focus pc1-pcN|next, "
        "network_pcN on|off, network_mask 0xNN, "
        "scan_interval 5-3600|next (needs updated firmware)",
        file=sys.stderr,
    )


def is_target(arg):
    return arg == "next" or arg.isdigit()


args = sys.argv[1:]

if len(args) == 1 and is_target(args[0]):
    command = f"select {args[0]}\n"
    mode = "select"

elif len(args) == 2 and len(args[0]) == 1 and args[0].isalpha() and is_target(args[1]):
    command = f"select {args[0]} {args[1]}\n"
    mode = "select"

elif len(args) == 1 and args[0] in ("state", "model"):
    command = f"{args[0]}\n"
    mode = args[0]

elif len(args) == 2 and args[0] == "query":
    name = args[1]

    if name not in QUERIES:
        print(f"Unknown query: {name}", file=sys.stderr)
        usage()
        sys.exit(2)

    command = f"query {name}\n"
    mode = "query"

elif len(args) == 3 and args[0] == "set":
    command = f"set {args[1]} {args[2]}\n"
    mode = "set"

else:
    usage()
    sys.exit(2)


try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(SOCKET)
        s.sendall(command.encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(4096)
            if not chunk:
                break
            data += chunk

    result = json.loads(data)

    if not result.get("ok"):
        print(
            result.get("error", "TESmart command failed"),
            file=sys.stderr,
        )
        sys.exit(1)

    if mode == "state":
        print(json.dumps(result["state"], indent=2))

    elif mode == "model":
        print(json.dumps({"ready": result["ready"], "model": result["model"]}, indent=2))

    elif mode in ("query", "set"):
        print(json.dumps(result, indent=2))

except Exception as ex:
    print(f"tesmartd error: {ex}", file=sys.stderr)
    sys.exit(1)
